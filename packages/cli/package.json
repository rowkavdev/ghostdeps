{
  "name": "@ghostdeps/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "ghostdeps": "./dist/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "test": "tsc -b tsconfig.json && node --test \"dist/**/*.test.js\"",
    "typecheck": "tsc -b tsconfig.json"
  },
  "dependencies": {
    "@ghostdeps/core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  }
}
