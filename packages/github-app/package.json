{
  "name": "@ghostdeps/github-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "pnpm --filter @ghostdeps/core --filter @ghostdeps/javascript-typescript --filter @ghostdeps/rust --filter @ghostdeps/go --filter @ghostdeps/python run build && tsc -p tsconfig.json && node --test \"dist/**/*.test.js\"",
    "typecheck": "pnpm --filter @ghostdeps/core --filter @ghostdeps/javascript-typescript --filter @ghostdeps/rust --filter @ghostdeps/go --filter @ghostdeps/python run build && tsc -p tsconfig.json --noEmit",
    "start": "probot run ./dist/index.js"
  },
  "dependencies": {
    "@ghostdeps/checks-renderer": "workspace:*",
    "@ghostdeps/core": "workspace:*",
    "@ghostdeps/go": "workspace:*",
    "@ghostdeps/javascript-typescript": "workspace:*",
    "@ghostdeps/python": "workspace:*",
    "@ghostdeps/rust": "workspace:*",
    "probot": "^14.3.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "nock": "^14.0.17",
    "typescript": "^5.9.3",
    "yaml": "^2.9.1"
  }
}
