{
  "name": "@ghostdeps/action",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "test": "tsc -b tsconfig.json && node --test \"dist/**/*.test.js\"",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@ghostdeps/checks-renderer": "workspace:*",
    "@ghostdeps/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "^5.7.0"
  }
}
